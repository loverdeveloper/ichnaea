# This file is for settings that are specific to your docker local development
# environment. Since these are specific to your local development environment,
# don't check them in.

# Default values for running the app with default configuration
# Copy this file to my.env and modify as needed for your environment

# ============================================================================
# User ID and Group ID Configuration
# ============================================================================
# If you want to set the uid and gid of the app user that we use in the
# containers, you can do that with these two variables.
# Linux users should set these to match their host UID/GID (run 'id' to see yours)
# macOS and Windows users can leave these commented out
# ICHNAEA_UID=10001
# ICHNAEA_GID=10001

# ============================================================================
# Database Engine Configuration
# ============================================================================
# Default: mysql_5_7 (x86_64/amd64 platforms)
# Apple Silicon (arm64) users MUST use MariaDB because MySQL 5.7 docker images
# are only available for amd64
# ICHNAEA_DOCKER_DB_ENGINE=mysql_5_7
# For Apple Silicon (M1/M2/M3 Macs):
# ICHNAEA_DOCKER_DB_ENGINE=mariadb_10_5

# ============================================================================
# Optional: Mapbox API Token
# ============================================================================
# Set this to enable map display on the website
# Get a free token at: https://account.mapbox.com
# MAPBOX_TOKEN=

# ============================================================================
# Optional: Debugging
# ============================================================================
# Set this if you're having serious problems that need Pyramid debugging
# PYRAMID_DEBUG_ALL=True

# ============================================================================
# Optional: Development Environment Overrides
# ============================================================================
# The following are already set in local_dev.env but can be overridden here:
#
# LOCAL_DEV_ENV=True
# LOGGING_LEVEL=INFO
# REDIS_URI=redis://redis:6379/0
# DB_READONLY_URI=mysql+pymysql://root:location@db:3306/location
# DB_READWRITE_URI=mysql+pymysql://root:location@db:3306/location
# SQLALCHEMY_URL=mysql+pymysql://root:location@db:3306/location
# CELERY_WORKER_CONCURRENCY=1
#
# See docker/config/local_dev.env for the complete list of default values
